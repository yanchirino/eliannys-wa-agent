{
  "name": "js-wa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "ask": "tsx --env-file=.env scripts/ask.ts",
    "check": "tsx scripts/selfcheck.ts",
    "typecheck": "tsc --noEmit",
    "d1:migrate": "wrangler d1 migrations apply eliannys-wa-agent --local"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@langchain/core": "^0.3.40",
    "@langchain/deepseek": "^0.1.0",
    "@langchain/langgraph": "^0.2.44",
    "@langchain/langgraph-checkpoint": "^0.0.18",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
