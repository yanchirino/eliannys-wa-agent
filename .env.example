DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
PORT=3000
MAX_ITERATIONS=2
MAX_TOOL_TURNS=8
QUERY_MAX_RETRIES=2

# Memory: 1 = Cloudflare D1 (durable, default), 0 = in-memory (se pierde al reiniciar).
# Dev con D1: pnpm exec wrangler d1 migrations apply eliannys-wa-agent --local
USE_D1=1
SHOP_BASE_URL=https://eliannys.com
SHOP_API_BASE_URL=https://eliannys.com/api/v1
SHOP_API_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
# Token Bearer para probar POST /message
AGENT_TOKEN=

# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
